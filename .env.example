# ─── Google Analytics 4 ───────────────────────────────────────────────────────
GA4_PROPERTY_ID=your_property_id_here

# ─── Local development ────────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# ─── For production (Vercel / Railway / etc.) ─────────────────────────────────
# Open credentials.json, copy the entire contents, and paste as one line below
GOOGLE_CREDENTIALS_JSON=paste_full_contents_of_credentials.json_here

# ─── Microsoft Clarity ────────────────────────────────────────────────────────
# JWT token from: Clarity project → Settings → Data Export → Generate New API Token
CLARITY_API_TOKEN=your_clarity_data_export_token

# ─── Google Play Console ──────────────────────────────────────────────────────
# Android package name (e.g. com.example.app)
PLAY_CONSOLE_PACKAGE_NAME=com.your.app
# Service account JSON with playdeveloperreporting scope
# Add the service account in Play Console → Setup → API access
PLAY_CONSOLE_CREDENTIALS_JSON=paste_service_account_json_here

# ─── PageSpeed Insights ───────────────────────────────────────────────────────
# Optional — without a key the API still works but has lower rate limits
# Get one at: console.cloud.google.com → APIs & Services → PageSpeed Insights API → Credentials
PAGESPEED_API_KEY=your_pagespeed_api_key

# ─── Apple App Store Connect ──────────────────────────────────────────────────
# API key: appstoreconnect.apple.com → Users and Access → Integrations → App Store Connect API
APP_STORE_KEY_ID=your_key_id
APP_STORE_ISSUER_ID=your_issuer_id
# Full .p8 private key contents with \n for newlines
APP_STORE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Vendor number: App Store Connect → Payments and Financial Reports
APP_STORE_VENDOR_NUMBER=your_vendor_number
